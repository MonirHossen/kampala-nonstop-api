# Kampala Nonstop API — Docker Compose variables
# Copy to .env.docker: cp .env.docker.example .env.docker

COMPOSE_PROJECT_NAME=kampala-nonstop-api

APP_PORT=8000
RUN_MIGRATIONS=true

# Public Angular site (used in waitlist invite / welcome email links)
FRONTEND_URL=http://localhost:4201

POSTGRES_DB=kampala_nonstop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Web DB admin (Adminer — like phpMyAdmin for PostgreSQL)
ADMINER_PORT=8082
