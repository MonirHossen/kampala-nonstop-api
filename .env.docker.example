# Kampala Nonstop API — Docker Compose variables
# Copy to .env.docker: cp .env.docker.example .env.docker

COMPOSE_PROJECT_NAME=kampala-nonstop-api

APP_PORT=8001
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:4201
CORS_ALLOWED_ORIGINS=http://localhost:4201,http://127.0.0.1:4201,http://localhost:4200,http://127.0.0.1:4200,http://localhost:8081,http://127.0.0.1:8081
RUN_MIGRATIONS=true

# Public Angular site (used in waitlist invite / welcome email links)
FRONTEND_URL=http://localhost:4201

POSTGRES_DB=kampala_nonstop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Web DB admin (Adminer — like phpMyAdmin for PostgreSQL)
ADMINER_PORT=8082

# Socialite OAuth (local Docker). Redirect URIs default to:
#   {APP_URL}/api/v1/auth/social/{google|facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_REDIRECT_URI=
