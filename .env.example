APP_NAME="Kampala Nonstop API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kampala_nonstop
DB_USERNAME=postgres
DB_PASSWORD=

# Docker: cp .env.docker.example .env.docker && set DB_HOST=postgres in .env, then make up

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=http://localhost:4200

# Comma-separated browser origins allowed to call the API (Angular local default).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Deploy pull API — main server uses main; dev/testing server uses dev
DEPLOY_BRANCH=main
DEPLOY_TOKEN=
# Host webhook from deploy/scripts/deploy-pull-api.py
DEPLOY_HOOK_URL=http://127.0.0.1:9090/pull

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=deloar.engr@gmail.com
MAIL_PASSWORD=qsyjwmvxdbcbhjpa
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=deloar.engr@gmail.com
MAIL_FROM_NAME="Kampala Nonstop"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
